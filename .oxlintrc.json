{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn", "oxc"],
  "categories": { "correctness": "error" },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "ignorePatterns": ["dist", "src/routeTree.gen.ts"],
  "overrides": [
    {
      // Keep components pulled from shadcn exactly as upstream; don't change them just to satisfy lint.
      // Route files must export Route next to their component, which is TanStack Router's file-based
      // routing contract, and theme-provider exports the useTheme hook. Neither can satisfy the rule.
      "files": [
        "src/components/ui/**",
        "src/components/theme-provider.tsx",
        "src/routes/**"
      ],
      "rules": { "react/only-export-components": "off" }
    }
  ]
}
